{#- Decoherence is on this list but is not one of the eight: it is the
    mechanism every interpretation has to account for. It gets its own block
    below rather than a ninth cell, which also keeps the headline honest. -#}
{%- set ways = theories | without("slug", "decoherence") %}
{%- set deco = theories | only("slug", "decoherence") %}

<main class="theories-page">
  <div class="theories-head">
    <p class="eyebrow">Theories</p>
    <h1>{{ ways | length | spell | title }} ways of<br>reading the same<br>experiment</h1>
    <p class="dek">They agree with every measurement ever taken. They disagree
      completely about what is happening. Weirdness is conserved &mdash; each one
      just puts it somewhere else.</p>
  </div>

  <div class="theory-grid">
      {%- for t in ways %}
      <a class="theory-card" href="/which-quantum-interpretation-are-you/theories/{{ t.slug }}/"{% if t.scored %} style="--c: var(--{{ t.key }})"{% endif %}>
        <svg class="card-motif" data-use-motif="{{ t.motif }}" aria-hidden="true"></svg>
        <h2>{{ t.name }}</h2>
        <p>{{ t.tagline | safe }}</p>
      </a>
      {%- endfor %}
  </div>

  {%- if deco %}
    <a class="theory-aside" href="/which-quantum-interpretation-are-you/theories/{{ deco.slug }}/">
      <svg class="card-motif" data-use-motif="{{ deco.motif }}" aria-hidden="true"></svg>
      <div>
        <p class="eyebrow">Not one of the eight</p>
        <h2>{{ deco.name }}</h2>
        <p class="aside-tag">{{ deco.tagline | safe }}</p>
        <p class="aside-note">The picture is the same one the disreputable uncle
          is drawn with, and the caption is the entire difference. This is not a
          reading of the experiment &mdash; it is the thing every reading above
          has to explain.</p>
      </div>
    </a>
  {%- endif %}
</main>

