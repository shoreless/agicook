<script>
document.querySelectorAll("[data-use-motif]").forEach(function (slot) {
  var src = document.querySelector('.motif[data-motif="' + slot.getAttribute("data-use-motif") + '"]');
  if (!src) return;
  var c = src.cloneNode(true);
  c.setAttribute("class", slot.getAttribute("class"));
  slot.replaceWith(c);
});
</script>
</body>
